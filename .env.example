# ==============================================================================
# ScanPlay Environment Variables
# Copy this file to .env.local and replace placeholders with your Supabase credentials.
# Do NOT commit .env.local to Git.
# ==============================================================================

# Supabase Project URL (Public)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Key (Public - Browser safe)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase Service Role Key (Private - Server-only administrative key)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role (secret)
# WARNING: NEVER expose this key to client components or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# Application Base URL (e.g. http://localhost:3000 locally, or https://scanplay.vercel.app in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
